BOT_DB_PATH=/var/lib/nutrition-bot/bot.sqlite3
BOT_DEFAULT_TIMEZONE=Europe/Moscow
# Replace with your actual Telegram ID. /id works before access is granted.
BOT_ALLOWED_USER_IDS=123456789
BOT_PUBLIC_REGISTRATION=false
AI_ENABLED=false
AI_PROVIDER=openai
# Lowest token price; scheduled retirement 2026-12-11. See docs/OPENAI.md.
AI_MODEL=gpt-5-nano
AI_DAILY_USER_LIMIT=10
AI_DAILY_GLOBAL_LIMIT=50
