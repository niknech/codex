BOT_DB_PATH=/var/lib/nutrition-bot/bot.sqlite3
BOT_DEFAULT_TIMEZONE=Europe/Moscow
# Replace with your actual Telegram ID. /id works before access is granted.
BOT_ALLOWED_USER_IDS=123456789
BOT_PUBLIC_REGISTRATION=false
# Administrators allowed to use /ai_bonus USER_ID [COUNT]. Empty disables the command.
BOT_ADMIN_USER_IDS=
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
# Optional paid web search for brands/restaurants. Missing setting defaults to false.
AI_WEB_SEARCH_ENABLED=true
AI_DAILY_USER_LIMIT=10
AI_DAILY_GLOBAL_LIMIT=50
