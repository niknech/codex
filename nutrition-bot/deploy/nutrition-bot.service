[Unit]
Description=Nutrition Telegram Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=nutritionbot
Group=nutritionbot
WorkingDirectory=/var/lib/nutrition-bot
StateDirectory=nutrition-bot
StateDirectoryMode=0700
EnvironmentFile=/etc/nutrition-bot/config.env
LoadCredential=telegram_token:/etc/nutrition-bot/telegram_token
LoadCredential=ai_api_key:/etc/nutrition-bot/ai_api_key
ExecStartPre=/opt/nutrition-bot/current/nutrition-bot --check-config
ExecStartPre=/opt/nutrition-bot/current/nutrition-bot --migrate
ExecStart=/opt/nutrition-bot/current/nutrition-bot --run
Restart=on-failure
RestartSec=10
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nutrition-bot

[Install]
WantedBy=multi-user.target
